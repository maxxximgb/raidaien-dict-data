{
  "version": "1.0.0",
  "built_at": "2026-05-12T16:12:34.425Z",
  "sections": [
    {
      "id": "os",
      "title": {
        "ru": "Особые буквы осетинского алфавита",
        "os": "Ирон ӕвзаджы хицӕн дамгъӕтӕ"
      },
      "letters": [
        {
          "letter": "Ӕ ӕ",
          "name": "ӕ",
          "ipa": "[æ]",
          "note": {
            "ru": "Краткий гласный переднего ряда. Произносится как русское «э» в слове «этот», но более открыто.",
            "os": "Цыбыр сӕрхаст хъӕлӕсон. Уырыссаг «э»-йы хуызӕн, фӕлӕ гомдӕр."
          },
          "ex": {
            "ru": "ӕвзаг — язык",
            "os": "ӕвзаг — æвзаг"
          }
        },
        {
          "letter": "Ы ы",
          "name": "ы",
          "ipa": "[ɨ]",
          "note": {
            "ru": "Сверхкраткий нейтральный гласный среднего ряда. Часто проглатывается между согласными.",
            "os": "Тынг цыбыр астӕуккаг хъӕлӕсон. Æмхъæлæсонты æхсæн арæх æмбæхст."
          },
          "ex": {
            "ru": "фыд — отец",
            "os": "фыд — фыд"
          }
        },
        {
          "letter": "Й й",
          "name": "й",
          "ipa": "[j]",
          "note": {
            "ru": "Полугласный (й-краткое). Звучит как русское «й» в «май».",
            "os": "Æрдæгхъæлæсон мыр. Уырыссаг «й»-йы хуызæн."
          },
          "ex": {
            "ru": "мӕй — луна",
            "os": "мӕй — мӕй"
          }
        },
        {
          "letter": "У у",
          "name": "у",
          "ipa": "[u] / [w]",
          "note": {
            "ru": "В начале слова и между гласными звучит как полугласный «в»/«у-краткое»; в остальных позициях — как обычный [u].",
            "os": "Дзырды райдайæны æмæ хъæлæсонты æхсæн æрдæгхъæлæсон, æндæр рæтты та хъæлæсон [u]."
          },
          "ex": {
            "ru": "уадул — щека",
            "os": "уадул — уадул"
          }
        },
        {
          "letter": "Дз дз",
          "name": "дз",
          "ipa": "[d͡z]",
          "note": {
            "ru": "Звонкая аффриката. Произносится слитно как «дз», единый звук.",
            "os": "«Д» æмæ «з»-йы иумæйаг мыр."
          },
          "ex": {
            "ru": "дзырд — слово",
            "os": "дзырд — дзырд"
          }
        },
        {
          "letter": "Дж дж",
          "name": "дж",
          "ipa": "[d͡ʒ]",
          "note": {
            "ru": "Звонкая аффриката. Соответствует английскому j в “jam”.",
            "os": "Англиссаг j-йы хуызæн иумæйаг мыр."
          },
          "ex": {
            "ru": "джиппи — джинн",
            "os": "джиппи — джиппи"
          }
        },
        {
          "letter": "Хъ хъ",
          "name": "хъ",
          "ipa": "[q]",
          "note": {
            "ru": "Глухой увулярный смычный. Произносится глубже «к», в самом нёбе.",
            "os": "Гуыдыры гом æвæргæ æзылангон мыр; «к»-йæ арфдæр."
          },
          "ex": {
            "ru": "хъӕу — село",
            "os": "хъӕу — хъӕу"
          }
        },
        {
          "letter": "Гъ гъ",
          "name": "гъ",
          "ipa": "[ʁ]",
          "note": {
            "ru": "Звонкий увулярный фрикативный. Похож на французское «r» в “Paris”.",
            "os": "Францаг «r»-йы хуызæн зылангон мыр."
          },
          "ex": {
            "ru": "гъӕды — лесной",
            "os": "гъӕды — гъæды"
          }
        },
        {
          "letter": "Цъ цъ",
          "name": "цъ",
          "ipa": "[t͡sʼ]",
          "note": {
            "ru": "Абруптивный (смычно-гортанный) «ц». Произносится с задержкой и резким щелчком.",
            "os": "Гуыдыр æхгæдгондæй дзургæ «ц»; гом мыр."
          },
          "ex": {
            "ru": "цъӕх — синий",
            "os": "цъӕх — цъæх"
          }
        },
        {
          "letter": "Чъ чъ",
          "name": "чъ",
          "ipa": "[t͡ʃʼ]",
          "note": {
            "ru": "Абруптивный «ч». Произносится с гортанной смычкой.",
            "os": "Гуыдыр æхгæдгондæй дзургæ «ч»."
          },
          "ex": {
            "ru": "чъири — пирог",
            "os": "чъири — чъири"
          }
        },
        {
          "letter": "Тъ тъ",
          "name": "тъ",
          "ipa": "[tʼ]",
          "note": {
            "ru": "Абруптивный «т». Резкий, с гортанной смычкой.",
            "os": "Гуыдыр æхгæдгондæй дзургæ «т»."
          },
          "ex": {
            "ru": "тъыфыл — клубок",
            "os": "тъыфыл — тъыфыл"
          }
        },
        {
          "letter": "Пъ пъ",
          "name": "пъ",
          "ipa": "[pʼ]",
          "note": {
            "ru": "Абруптивный «п». Произносится с лёгким щелчком губ.",
            "os": "Гуыдыр æхгæдгондæй дзургæ «п»."
          },
          "ex": {
            "ru": "пъырыс — спор",
            "os": "пъырыс — пъырыс"
          }
        },
        {
          "letter": "Къ къ",
          "name": "къ",
          "ipa": "[kʼ]",
          "note": {
            "ru": "Абруптивный «к». Гортанно-смычный заднеязычный.",
            "os": "Гуыдыр æхгæдгондæй дзургæ «к»."
          },
          "ex": {
            "ru": "къах — нога",
            "os": "къах — къах"
          }
        }
      ]
    }
  ]
}
